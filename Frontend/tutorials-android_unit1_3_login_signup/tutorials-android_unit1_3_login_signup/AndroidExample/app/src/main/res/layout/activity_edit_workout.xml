<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#212121">

        <!-- Workout ID Input Field -->
        <EditText
            android:id="@+id/edit_workout_id_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Workout ID"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#888888"
            android:layout_marginBottom="16dp" />

        <!-- Date Input Fields (MM, DD, YYYY) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/edit_month_edt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="MM"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#888888" />

            <View
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edit_day_edt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="DD"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#888888" />

            <View
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edit_year_edt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="YYYY"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#888888" />
        </LinearLayout>

        <!-- Workout Length Input -->
        <EditText
            android:id="@+id/edit_workout_length_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Workout Length (in minutes)"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#888888"
            android:layout_marginBottom="16dp" />

        <!-- Total Weight Input -->
        <EditText
            android:id="@+id/edit_total_weight_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Total Weight Lifted"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#888888"
            android:layout_marginBottom="16dp" />

        <!-- Exercises Performed Input -->
        <EditText
            android:id="@+id/edit_exercises_performed_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Exercises Performed (JSON format)"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#888888"
            android:layout_marginBottom="16dp" />

        <!-- Additional Notes Input -->
        <EditText
            android:id="@+id/edit_notes_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Additional Notes"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#888888"
            android:layout_marginBottom="24dp" />

        <!-- Fetch Workout Button -->
        <Button
            android:id="@+id/fetch_workout_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fetch Workout"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800"
            android:layout_marginBottom="16dp" />

        <!-- Save Workout Button -->
        <Button
            android:id="@+id/save_workout_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Workout"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7E57C2"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
