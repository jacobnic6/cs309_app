<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#212121">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Add New Workout Section -->
            <Button
                android:id="@+id/add_workout_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add New Workout"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A5ACD"
                android:layout_marginBottom="24dp"/>

            <!-- Edit Workout Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Workout"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edit_workout_id_edt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Workout ID"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#888888"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/edit_workout_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Workout"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4A4A4A"
                android:layout_marginBottom="24dp"/>

            <!-- Delete Workout Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Workout"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/delete_workout_id_edt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Workout ID"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#888888"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/delete_workout_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Workout"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF5555"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline"
        app:layout_constraintVertical_bias="0.0"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>