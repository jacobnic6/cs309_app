<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WorkoutActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Section: Create a Workout -->
        <Button
            android:id="@+id/create_workout_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create a Workout"
            android:backgroundTint="#6A5ACD"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Section: Workout Templates (future feature) -->
        <Button
            android:id="@+id/workout_templates_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Workout Templates"
            android:backgroundTint="#6A5ACD"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Section: View Your Workouts -->
        <Button
            android:id="@+id/view_workouts_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Workouts"
            android:backgroundTint="#6A5ACD"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Placeholder for displaying workout list -->
        <TextView
            android:id="@+id/workout_list_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="List of Workouts will appear here..."
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <!-- Section: Update/Delete -->
        <EditText
            android:id="@+id/workout_id_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Workout ID to Edit/Delete"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/edit_workout_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Workout"
            android:backgroundTint="#FF8C00"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/delete_workout_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Workout"
            android:backgroundTint="#FF6347"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
