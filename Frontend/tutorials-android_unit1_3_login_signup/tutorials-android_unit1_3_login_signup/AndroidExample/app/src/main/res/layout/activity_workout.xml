<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Section: Log a New Workout -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="Log a New Workout"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <EditText
            android:id="@+id/workout_start_time_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start Time (yyyy-MM-dd HH:mm:ss)"
            android:inputType="datetime" />

        <EditText
            android:id="@+id/workout_length_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Workout Length (in minutes)"
            android:inputType="number" />

        <EditText
            android:id="@+id/total_weight_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Total Weight Lifted"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/exercises_performed_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Exercises Performed (JSON format)"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/log_workout_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log Workout"
            android:layout_marginTop="10dp" />

        <!-- Section: Retrieve and Display Workouts -->
        <Button
            android:id="@+id/view_workouts_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Past Workouts"
            android:layout_marginTop="16dp" />

        <!-- Section: Edit Workout -->
        <EditText
            android:id="@+id/edit_workout_id_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Workout ID to Edit"
            android:inputType="number"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/edit_workout_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Workout"
            android:layout_marginTop="10dp" />

        <!-- Section: Delete Workout -->
        <EditText
            android:id="@+id/delete_workout_id_edt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Workout ID to Delete"
            android:inputType="number"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/delete_workout_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Workout"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FF6347"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
