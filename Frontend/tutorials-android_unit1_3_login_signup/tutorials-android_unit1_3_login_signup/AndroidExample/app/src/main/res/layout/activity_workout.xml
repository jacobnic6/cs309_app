<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#2C2C2C"> <!-- Dark Grey Background -->

    <!-- Title TextView -->
    <TextView
        android:id="@+id/title_workout_activity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Workout Management"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Button to Navigate to Log Workout Page -->
    <Button
        android:id="@+id/navigate_log_workout_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log a New Workout"
        android:padding="16dp"
        android:backgroundTint="#6A5ACD"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/title_workout_activity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- View Workouts Button -->
    <Button
        android:id="@+id/view_workouts_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Past Workouts"
        android:padding="16dp"
        android:backgroundTint="#3CB371"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/navigate_log_workout_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Edit Workout Section -->
    <EditText
        android:id="@+id/edit_workout_id_edt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Workout ID to Edit"
        android:inputType="number"
        android:padding="16dp"
        android:backgroundTint="#8A8A8A"
        android:textColorHint="#E0E0E0"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/view_workouts_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/edit_workout_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Workout"
        android:padding="16dp"
        android:backgroundTint="#FFA500"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/edit_workout_id_edt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Delete Workout Section -->
    <EditText
        android:id="@+id/delete_workout_id_edt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Workout ID to Delete"
        android:inputType="number"
        android:padding="16dp"
        android:backgroundTint="#8A8A8A"
        android:textColorHint="#E0E0E0"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/edit_workout_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/delete_workout_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Workout"
        android:padding="16dp"
        android:backgroundTint="#FF6347"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/delete_workout_id_edt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
